{
  "manifest_version": 3,
  "name": "Simple Reminder",
  "version": "1.0.0",
  "description": "Shows a browser reminder popup after a set timer.",
  "permissions": ["storage", "alarms", "windows"],
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Simple Reminder"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}